{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "NCorePro.UI.Client": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist",
                        "index": "src/index.html",
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "allowedCommonJsDependencies": [
                            "primeng",
                            "quill",
                            "core-js",
                            "raf",
                            "rgbcolor",
                            "jspdf",
                            "html2canvas",
                            "crypto-js",
                            "jspdf-autotable",
                            "dompurify",
                            "file-saver",
                            "lz-string",
                            "xlsx-js-style",
                            "lottie-web",
                            "quill-delta"
                        ],
                        "assets": [
                            "src/favicon.ico",
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "**/*",
                                "input": "src/assets",
                                "output": "assets"
                            }
                        ],
                        "styles": [
                            "src/assets/styles.scss",
                            "src/assets/tailwind.css"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "p10002": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "30mb",
                                    "maximumError": "50mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "30mb",
                                    "maximumError": "30mb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.p10002.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true
                        },
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "30mb",
                                    "maximumError": "50mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "30mb",
                                    "maximumError": "30mb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.production.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true
                        },
                        "p10001": {
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "30mb",
                                    "maximumError": "50mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "5mb",
                                    "maximumError": "5mb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.p10001.ts"
                                }
                            ]
                        },
                        "localhost": {
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true
                        }
                    },
                    "defaultConfiguration": "localhost"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "p10002": {
                            "buildTarget": "NCorePro.UI.Client:build:p10002"
                        },
                        "production": {
                            "buildTarget": "NCorePro.UI.Client:build:production"
                        },
                        "p10001": {
                            "buildTarget": "NCorePro.UI.Client:build:p10001",
                            "hmr": true
                        },
                        "localhost": {
                            "buildTarget": "NCorePro.UI.Client:build:localhost",
                            "hmr": true
                        }
                    },
                    "defaultConfiguration": "localhost"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                        "buildTarget": "NCorePro.UI.Client:build"
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "tsConfig": "tsconfig.spec.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets"
                        ],
                        "styles": [
                            "src/assets/styles.scss"
                        ],
                        "scripts": []
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false,
        "cache": {
            "enabled": true,
            "path": ".angular/cache"
        }
    }
}